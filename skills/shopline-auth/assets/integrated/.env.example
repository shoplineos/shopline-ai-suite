# ============================================================
# SHOPLINE App — Integrated Architecture Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# --- Application credentials (from SHOPLINE Developer Platform) ---
APP_KEY=your_app_key_here
APP_SECRET=your_app_secret_here

# --- Application settings ---
APP_NAME=my-shopline-app
APP_SCOPES=read_orders,write_orders

# --- Deployment ---
# The public URL where this service is deployed.
# Must match the "App home page URL" registered on the SHOPLINE Developer Platform.
# IMPORTANT: Include the protocol (https://).
# Correct:   https://my-app.example.com
# Incorrect: my-app.example.com
APP_HOME_URL=https://my-app.example.com

# Server port (default: 3000)
PORT=3000
