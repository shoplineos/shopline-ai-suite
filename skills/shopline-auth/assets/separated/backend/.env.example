# ============================================================
# SHOPLINE App — Separated Architecture: Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# NEVER expose APP_SECRET to the frontend — all signing is done here.

# --- Application credentials (from SHOPLINE Developer Platform) ---
APP_KEY=your_app_key_here
APP_SECRET=your_app_secret_here

# --- Application settings ---
APP_NAME=my-shopline-app
APP_SCOPES=read_orders,write_orders

# --- URLs (include protocol) ---
# Frontend URL: where users are redirected after auth
# Local dev: http://localhost:3000
# Production: https://my-app-frontend.example.com
FRONTEND_URL=http://localhost:3000

# Backend URL: the public URL of THIS backend service
# SHOPLINE OAuth callback will redirect to this URL.
# Local dev: use cloudflare tunnel URL, e.g. https://xxx-yyy.trycloudflare.com
# Production: https://my-app-backend.example.com
BACKEND_URL=https://xxx-yyy.trycloudflare.com

# CORS: allowed origin for your frontend
# Use * for local development; restrict to specific origin in production
CORS_ORIGIN=*

# Server port (default: 8080)
PORT=8080
