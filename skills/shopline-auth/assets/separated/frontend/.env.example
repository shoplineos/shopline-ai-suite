# ============================================================
# SHOPLINE App — Separated Architecture: Frontend Environment Variables
# ============================================================
# Only PUBLIC values go here. NEVER put APP_SECRET in the frontend.

# The base URL of your backend API service
BACKEND_API_URL=https://my-app-backend.example.com

# The public URL of this frontend (used to build callback URLs passed to backend)
# IMPORTANT: Include the protocol (https://).
# Correct:   https://my-app-frontend.example.com
# Incorrect: my-app-frontend.example.com
APP_HOME_URL=https://my-app-frontend.example.com
